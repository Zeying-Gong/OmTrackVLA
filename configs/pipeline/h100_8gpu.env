# OmTrackVLA single-node 8xH100 pipeline configuration.
# This file is sourced by scripts/run_pipeline_8xh100.sh and must remain valid Bash.

# Leave empty to auto-detect python, then python3, from the activated environment.
PIPELINE_PYTHON="${PIPELINE_PYTHON:-}"
PIPELINE_NPROC_PER_NODE="${PIPELINE_NPROC_PER_NODE:-8}"
PIPELINE_MASTER_ADDR="${PIPELINE_MASTER_ADDR:-127.0.0.1}"
PIPELINE_MASTER_PORT="${PIPELINE_MASTER_PORT:-29500}"
PIPELINE_RUNS_ROOT="${PIPELINE_RUNS_ROOT:-$REPO_ROOT/outputs/training}"
PIPELINE_DATA_ROOT="${OMTRACKVLA_DATA_ROOT:-$REPO_ROOT/data}"

# Reproducibility/safety checks. Development runs may override them with CLI flags.
PIPELINE_REQUIRE_CLEAN_GIT="${PIPELINE_REQUIRE_CLEAN_GIT:-1}"
PIPELINE_EXPECT_H100="${PIPELINE_EXPECT_H100:-1}"

# Canonical Python module contract. The real Phase 1 implementation is present;
# the same entry points intentionally reject Phase 2/3 until those phases exist.
PIPELINE_TRAIN_MODULE="${PIPELINE_TRAIN_MODULE:-omtrackvla.training.train}"
PIPELINE_EVAL_MODULE="${PIPELINE_EVAL_MODULE:-omtrackvla.evaluation.evaluate}"
PIPELINE_RENDER_MODULE="${PIPELINE_RENDER_MODULE:-omtrackvla.evaluation.render}"
PIPELINE_GATE_MODULE="${PIPELINE_GATE_MODULE:-omtrackvla.evaluation.gate}"

PIPELINE_LAST_CHECKPOINT_REL="checkpoints/last.ckpt"
PIPELINE_BEST_CHECKPOINT_REL="checkpoints/best.ckpt"

PHASE1_TRAIN_CONFIG="configs/phases/phase1_pretrain.yaml"
PHASE1_BENCHMARK_CONFIG="configs/benchmarks/phase1.yaml"
PHASE1_GATE_CONFIG="configs/gates/phase1.yaml"
PHASE1_INIT_CHECKPOINT=""
PHASE1_TRAIN_ARGS=()
PHASE1_EVAL_ARGS=()
PHASE1_RENDER_ARGS=()
PHASE1_GATE_ARGS=()

PHASE2_TRAIN_CONFIG="configs/phases/phase2_following_sft.yaml"
PHASE2_BENCHMARK_CONFIG="configs/benchmarks/phase2.yaml"
PHASE2_GATE_CONFIG="configs/gates/phase2.yaml"
PHASE2_INIT_CHECKPOINT=""
PHASE2_TRAIN_ARGS=()
PHASE2_EVAL_ARGS=()
PHASE2_RENDER_ARGS=()
PHASE2_GATE_ARGS=()

PHASE3_TRAIN_CONFIG="configs/phases/phase3_recovery.yaml"
PHASE3_BENCHMARK_CONFIG="configs/benchmarks/phase3.yaml"
PHASE3_GATE_CONFIG="configs/gates/phase3.yaml"
PHASE3_INIT_CHECKPOINT=""
PHASE3_TRAIN_ARGS=()
PHASE3_EVAL_ARGS=()
PHASE3_RENDER_ARGS=()
PHASE3_GATE_ARGS=()
