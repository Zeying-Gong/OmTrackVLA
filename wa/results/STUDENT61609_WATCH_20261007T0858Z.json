g\",taskroot/\".md-ak/workload.log\"]\n        worker_ages=[]; rows_ages=[]; row_bytes=0\n        for lane in range(8):\n            dest=root/f\"shard_{lane:02d}\"\n            ready=json.loads((dest/\"server_ready.json\").read_text())\n            validate_ready(ready,mode=\"mixed\",**contract)\n            assert \"A800\" in ready[\"gpu\"]\n            ready_count+=1\n            f=dest/\"episodes.jsonl\"; data=f.read_bytes(); row_bytes+=len(data)\n            lines=data.splitlines(keepends=True)\n            if lines and not lines[-1].endswith(b\"\\n\"):\n                partial+=1; lines=lines[:-1]\n            local=[json.loads(s) for s in lines if s.strip()]\n            expected={e[\"key\"] for e in manifest[\"tasks\"][task][\"episodes\"] if e[\"shard\"]==lane}\n            for row in local:\n                key=(row[\"task\"],row[\"key\"])\n                assert row[\"task\"]==task and row[\"key\"] in expected,(\"foreign row\",key,lane)\n                assert key not in seen and key not in allkeys,(\"duplicate\",key)\n                seen.add(key);allkeys.add(key)\n                assert row[\"checkpoint_sha256\"]==contract[\"checkpoint_sha\"] and row[\"checkpoint_step\"]==contract[\"step\"]\n                assert row[\"mode\"]==\"mixed\" and row[\"noise_mode\"]==\"zero\"\n                assert row[\"controller\"]==\"learned_yaw_guard_v1\" and row[\"semantic_protocol\"]==\"mp3d_semantic_ply_v1\"\n                if key in KEYS:\n                    assert row[\"initialization_repair\"]==VERSION and row[\"initialization_repair_plan_sha256\"]==REPAIR_SHA\n                else: assert not row.get(\"initialization_repair\")\n                assert type(row[\"policy_init_valid\"]) is bool\n                invalid+=int(not row[\"policy_init_valid\"])\n                assert row[\"success\"] in (False,True,0,1) and row[\"collision\"] in (False,True,0,1)\n            lanes.append(len(local));completions+=int((dest/\"COMPLETE.json\").exists())\n            logs.extend([dest/\"worker.log\",dest/\"server.log\"])\n            worker_ages.append(round(now-(dest/\"worker.log\").stat().st_mtime,2))\n            rows_ages.append(round(now-f.stat().st_mtime,2))\n        hits=[]; logbytes=0\n        for path in logs:\n            assert path.is_file(),(\"required_log_missing\",str(path))\n            size=path.stat().st_size;start=offsets.get(str(path),0)\n            assert size>=start,(\"log_truncated\",str(path))\n            with path.open(\"rb\") as stream:\n                stream.seek(max(0,start-512)); data=stream.read()\n            for marker in fatal_patterns:\n                count=data.count(marker.encode())\n                if count: hits.append(dict(path=str(path),pattern=marker,count=count))\n            offsets[str(path)]=size;logbytes+=size\n        count=len(seen);before=previous_counts.get(task)\n        result[\"tasks\"][task]=dict(job=jid,task_id=tid,completed=count,lanes=lanes,delta=None if before is None else count-before,\n            invalid_init=invalid,ready=ready_count,complete_shards=completions,partial_tails=partial,row_bytes=row_bytes,\n            log_bytes=logbytes,log_growth=None if task not in previous_log_sizes else logbytes-previous_log_sizes[task],\n            worker_log_age_s=worker_ages,episode_file_age_s=rows_ages,fatal_hits=hits,\n            partition_complete=(root/\"PARTITION_COMPLETE.json\").exists())\n        if before is not None: assert count>=before\n        previous_counts[task]=count;previous_log_sizes[task]=logbytes\n    result[\"unique_completed\"]=len(allkeys)\n    print(json.dumps(result,allow_nan=False),flush=True)\n    if any(r[\"fatal_hits\"] for r in result[\"tasks\"].values()): raise RuntimeError(\"specified fatal signature found; inspect original task, do not restart automatically\")\n    if all(r[\"partition_complete\"] for r in result[\"tasks\"].values()): break\n    if snapshot<12:time.sleep(50)\nprint(\"BOUNDED_READONLY_WATCH_FINISHED_NOT_JOB_COMPLETION\",flush=True